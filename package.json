{
  "name": "agentlore",
  "version": "0.0.0",
  "description": "Your second brain for AI coding agents: local-first memory of every session and of each project, shared by Claude Code, Codex, Cursor and Antigravity.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude-code",
    "codex",
    "cursor",
    "gemini",
    "antigravity",
    "ai-agents",
    "agents",
    "memory",
    "knowledge",
    "sqlite",
    "full-text-search",
    "cli"
  ],
  "homepage": "https://github.com/hodfords-solutions/agentlore#readme",
  "bugs": {
    "url": "https://github.com/hodfords-solutions/agentlore/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodfords-solutions/agentlore.git"
  },
  "license": "MIT",
  "author": "Cong Nguyen <cong.nc@hodfords.com>",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "lore": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docs:pdf": "node scripts/render-how-it-works.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
